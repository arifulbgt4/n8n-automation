NODE_ENV=development
APP_ENV=local
APP_VERSION=0.1.0

API_HOST=0.0.0.0
API_PORT=4000

DATABASE_URL=postgresql://app_user:change-me@postgres-host:5432/app_db
REDIS_URL=redis://redis-host:6379
REDIS_KEY_PREFIX=n8nauto

MEDIA_BASE_URL=https://media-service.example.com
MEDIA_API_KEY=replace-with-tenant-or-platform-media-key

INTERNAL_SERVICE_AUTH_SECRET=replace-with-at-least-32-random-characters
N8N_WORKFLOW_BUNDLE_VERSION=0.1.0

AUTH_BASE_URL=http://localhost:4000
AUTH_SECRET=replace-with-at-least-32-random-characters
CUSTOMER_PANEL_ORIGIN=http://localhost:3000
SUPER_ADMIN_PANEL_ORIGIN=http://localhost:3001
