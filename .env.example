# Application database (existing PostgreSQL service)
DATABASE_URL=postgresql://app_user:change-me@postgres:5432/app_db

# Existing Redis service
REDIS_URL=redis://default:change-me@redis:6379/0
QUEUE_PREFIX=n8nauto:development

# Application security
APP_ENCRYPTION_KEY=replace-with-64-hex-characters
SESSION_COOKIE_NAME=n8nauto_session
SESSION_TTL_DAYS=30
CSRF_HEADER_NAME=x-csrf-token
CUSTOMER_APP_ORIGIN=http://localhost:3000
ADMIN_APP_ORIGIN=http://localhost:3001
API_PUBLIC_ORIGIN=http://localhost:4000
INTERNAL_SERVICE_AUTH_SECRET=replace-with-long-random-value

# Optional outbound email delivery webhook. The endpoint receives JSON mail jobs.
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_FROM=no-reply@example.com

# Existing Media Storage service. Keep credentials server-side.
MEDIA_BASE_URL=
MEDIA_API_KEY=
# Optional: if tenant media users should be provisioned automatically by the SaaS.
MEDIA_ADMIN_TOKEN=

# Existing n8n runtime integration
N8N_TURN_WEBHOOK_URL=
N8N_TRAINING_WEBHOOK_URL=
N8N_HEALTH_WEBHOOK_URL=
N8N_WORKFLOW_BUNDLE_VERSION=1.0.0

# Meta / channel defaults
META_APP_ID=
META_OAUTH_REDIRECT_URI=http://localhost:4000/v1/channels/meta/oauth/callback
META_GRAPH_API_VERSION=v23.0
META_VERIFY_TOKEN=
META_APP_SECRET=

# Worker behavior
AGGREGATION_WINDOW_MS=4500
AGGREGATION_MAX_MESSAGES=20
OUTBOUND_DEFAULT_RATE_PER_MINUTE=30
OUTBOUND_DEFAULT_BURST=5
WORKER_CONCURRENCY=10

# Vector dimensions must match selected embedding model.
EMBEDDING_DIMENSIONS=1536

# Logging
LOG_LEVEL=info
NODE_ENV=development
