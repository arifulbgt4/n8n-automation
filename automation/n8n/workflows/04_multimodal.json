      "id": "14000000-0000-4000-8000-000000000001",
      "name": "Multimodal Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-720, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "14000000-0000-4000-8000-000000000010",
              "leftValue": "={{$json.headers?.authorization || $json.headers?.Authorization || ''}}",
              "rightValue": "={{'Bearer ' + $env.INTERNAL_SERVICE_AUTH_SECRET}}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "14000000-0000-4000-8000-000000000004",
      "name": "Authorize Internal Caller",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-470, 0]
    },
    {
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "Unauthorized multimodal workflow call"
      },
      "id": "14000000-0000-4000-8000-000000000005",
      "name": "Reject Unauthorized Caller",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [-220, 180]
    },
    {
      "parameters": {
        "url": "={{$env.SAAS_API_INTERNAL_URL + '/v1/internal/runtime/turn/' + ($json.body || $json).turnId}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.INTERNAL_SERVICE_AUTH_SECRET}}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "14000000-0000-4000-8000-000000000002",
      "name": "Load Media Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-220, -80]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "turn-id",
              "name": "turnId",
              "value": "={{$json.turn.id}}",
              "type": "string"
            },
            {
              "id": "message-count",
              "name": "messageCount",
              "value": "={{($json.messages || []).length}}",
              "type": "number"
            },
            {
              "id": "media-count",
              "name": "mediaCount",
              "value": "={{($json.media || []).length}}",
              "type": "number"
            },
            {
              "id": "has-image",
              "name": "hasImage",
              "value": "={{($json.media || []).some(item => item.kind === 'image' || String(item.mime_type || '').startsWith('image/'))}}",
              "type": "boolean"
            },
            {
              "id": "has-audio",
              "name": "hasAudio",
              "value": "={{($json.media || []).some(item => item.kind === 'audio' || String(item.mime_type || '').startsWith('audio/'))}}",
              "type": "boolean"
            },
            {
              "id": "ready",
              "name": "ready",
              "value": true,
              "type": "boolean"
            }
          ]
        },
        "options": {}
      },
      "id": "14000000-0000-4000-8000-000000000003",
      "name": "Multimodal Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [80, -80]
    }
  ],
  "pinData": {},
